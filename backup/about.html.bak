orm w-form"><form id="wf-form-Newsletter-Form" name="wf-form-Newsletter-Form" data-name="Newsletter Form" method="get" class="footer-form" data-wf-page-id="6ac54b6e7658570aaa3bd29e" data-wf-element-id="b192bfc0-fc73-026f-8d1d-66ae478988e0"><div class="field-wrapper"><input class="footer-text-field w-input" maxlength="256" name="Newsletter-Email" data-name="Newsletter-Email" aria-label="Email Address" placeholder="Enter your email" type="email" id="Newsletter-Email" required=""/></div><input type="submit" data-wait="Please wait..." class="submit-button footer w-button" value="Submit"/></form><div class="success-message w-form-done"><div>Thank you! Your submission has been received!</div></div><div class="error-message w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></div><div class="space-5-small"></div><div class="copyright-wrapper"><div class="footer-bottom"><div class="copyright-text">© Copyright <span>- </span><span>Cuckoo Safaris </span>Design By <a href="https://webflow.com/templates/designers/lioweb" target="_blank" class="utility-link"><span>Lioweb</span></a><span> </span>Licenses By <a href="https://webflow.com/" target="_blank" class="utility-link">Webflow</a></div><div class="uitlity-link-wrap"><a href="style-guide.html" class="utility-link">Style Guide</a><a href="license.html" class="utility-link">Licenses</a><a href="changelog.html" class="utility-link">Changelog</a><a href="404.html" class="utility-link">404</a></div></div></div></section></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a13e532999601af0ed6354d" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6a13e532999601af0ed6354d/js/webflow.schunk.f2efb3c5440a81cf.js" type="text/javascript" integrity="sha384-VK02VJvMib7ytrF5M2joPWNtDQs366FZgEQ5B+Iwnjx0WBnwQXfootyziSYxdrmS" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6a13e532999601af0ed6354d/js/webflow.schunk.71cfc923865119db.js" type="text/javascript" integrity="sha384-hr4WDa8l9X3l+W0XwBXDYcYru+ByXq/KozJPgRuNSH9gEZNlR0niNSRCnGT026NH" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6a13e532999601af0ed6354d/js/webflow.b07a6241.2c2bf4d4e75d9ea0.js" type="text/javascript" integrity="sha384-yXj2e1xAdaSbVN/+WmQPmpLuru+jNyFOoAkSakUufPMcKJapbM7RAjYRzzHfE/MH" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/SplitText.min.js" type="text/javascript"></script><script>
document.addEventListener("DOMContentLoaded", () => {
  if (!window.gsap) return;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  if (matchMedia("(pointer: coarse)").matches) return; // mobile e native scroll

  const html = document.documentElement;
  html.style.scrollBehavior = "auto";

  const SPEED = 1;       // wheel e koto dur jabe
  const DURATION = 1.1;  // beshi = aro smooth
  const pos = { y: window.scrollY };
  let target = window.scrollY;
  let animating = false;

  const maxScroll = () => html.scrollHeight - window.innerHeight;
  const stop = () => { gsap.killTweensOf(pos); animating = false; };

  window.addEventListener("wheel", (e) => {
    if (e.ctrlKey || e.defaultPrevented) return;
    if (e.target.closest && e.target.closest("[data-native-scroll]")) return;
    e.preventDefault();

    let d = e.deltaY;
    if (e.deltaMode === 1) d *= 16;
    else if (e.deltaMode === 2) d *= window.innerHeight;

    if (!animating) pos.y = target = window.scrollY;
    target = gsap.utils.clamp(0, maxScroll(), target + d * SPEED);
    animating = true;

    gsap.to(pos, {
      y: target,
      duration: DURATION,
      ease: "power3.out",
      overwrite: true,
      onUpdate: () => window.scrollTo(0, pos.y),
      onComplete: () => { animating = false; }
    });
  }, { passive: false });

  window.addEventListener("mousedown", stop);
  window.addEventListener("keydown", stop);
  document.addEventListener("click", (e) => {
    if (e.target.closest && e.target.closest('a[href*="#"]')) stop();
  });
  window.addEventListener("scroll", () => {
    if (!animating) pos.y = target = window.scrollY;
  }, { passive: true });
});
</script></body></html>