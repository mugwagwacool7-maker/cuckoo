="0"></div></div><div class="nav-button-wrap"><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="destination.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Plan a Safari</div><div class="primay-button-text _02">Plan a Safari</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div></div><section class="section"><div class="w-layout-blockcontainer container w-container"><div class="about-hero-wrap"><div class="about-hero-top"><div class="about-badge-wrap"><div data-wf--section-badge--variant="bg" class="section-badge w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f"><div class="badge-text w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f">About Cuckoo Safaris</div></div></div><div class="about-hero-title-wrap"><h1 class="inner-hero-heading">Your southern Africa adventure starts here</h1></div></div><div class="about-hero-bottom"><div class="about-hero-text-wrap"><p class="about-hero-text">Discover Victoria Falls and the region with a local team that knows the routes and experiences on the ground.</p></div><div class="about-hero-buttons"><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="contact.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Contact Us</div><div class="primay-button-text _02">Contact Us</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="destination.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Explore Journeys</div><div class="primay-button-text _02">Explore Journeys</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div></div></section></div><div class="main"><section class="section"><div class="space-8-small"></div><div class="w-layout-blockcontainer container w-container"><div class="about-intro-grid"><div class="about-intro-image-wrap"><img src="https://irp.cdn-website.com/e6c865a4/dms3rep/multi/opt/Vic_Falls_Feb_2016_Sarah_Kerr-1421-e1650922121587-1920w.jpg" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 938px) 95vw, 892px" alt="The spray of Victoria Falls rising above the rainforest" class="about-cover-image"/></div><div class="about-content-stack"><div class="pill-wrap"><div data-wf--section-badge--variant="bg" class="section-badge w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f"><div class="badge-text w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f">Our Story</div></div></div><div class="story-middle"><h2 class="section-heading night">Local safari specialists in Victoria Falls, Zimbabwe.</h2><p class="story-summary">Based in Victoria Falls, Zimbabwe, Cuckoo Safaris helps travellers explore the region through guided experiences, wildlife safaris and multi-day journeys.</p><p class="story-summary">From the Victoria Falls rainforest and Zambezi River to Hwange, Chobe and the Okavango Delta, our team can help you plan a trip that suits your time and interests.</p></div><div class="btn-wrap"><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="package.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">View Safaris</div><div class="primay-button-text _02">View Safaris</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div><div class="w-layout-grid story-bottom-grid about"><div class="story-card"><div class="story-card-top"><div class="story-icon-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 28 28" fill="none" class="story-card-icon"><path d="M21 2.3335H7C5.06333 2.3335 3.5 3.88516 3.5 5.7985V18.5268C3.5 20.4402 5.06333 21.9918 7 21.9918H7.88667C8.82 21.9918 9.70667 22.3535 10.36 23.0068L12.355 24.9785C13.265 25.8768 14.7467 25.8768 15.6567 24.9785L17.6517 23.0068C18.305 22.3535 19.2033 21.9918 20.125 21.9918H21C22.9367 21.9918 24.5 20.4402 24.5 18.5268V5.7985C24.5 3.88516 22.9367 2.3335 21 2.3335ZM14.3267 17.4535C14.1517 17.5118 13.86 17.5118 13.6733 17.4535C12.1567 16.9285 8.75 14.7702 8.75 11.0952C8.76167 9.4735 10.0567 8.16683 11.6667 8.16683C12.6233 8.16683 13.4633 8.62183 14 9.3335C14.5367 8.62183 15.3767 8.16683 16.3333 8.16683C17.9433 8.16683 19.25 9.4735 1