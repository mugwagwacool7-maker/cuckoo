41ab4b&quot;],[]]]" class="about-split-header"><div class="about-split-title"><div class="badge-wrap"><div data-wf--section-badge--variant="bg" class="section-badge w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f"><div class="badge-text w-variant-cbbf38fe-d1d9-25df-a3f8-ed2322a2901f">Travel Categories</div></div></div><h2 class="section-heading night">Find the kind of travel that feels like you.</h2></div><div class="about-split-text"><p class="about-text">Choose a day tour, wildlife safari or multi-day journey, and our local team will help shape it around your interests.</p></div></div><div class="about-panels"><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;9bb26972-7e9b-4ff3-05f2-07e920775336&quot;],[]]]" id="w-node-_9bb26972-7e9b-4ff3-05f2-07e920775336-aa3bd29e" class="about-panel active"><img src="https://irp.cdn-website.com/e6c865a4/dms3rep/multi/opt/IMG_2878+%28002%29-1920w.jpg" loading="lazy" alt="Wildlife on the savannah in southern Africa" class="about-panel-image"/><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;1d9f9f9e-6af1-aa02-2911-58fccb64046e&quot;],[]]]" class="about-panel-overlay active"></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;57b434cd-4bda-7d09-f1c4-b5e5eecab856&quot;],[]]]" class="about-panel-content active"><div><p data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;f08630d7-619a-b622-7baa-88191a753235&quot;],[]]]" class="about-panel-number active">01</p></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;d5cd1685-49fc-c18e-3ac7-bcbdd35f6648&quot;],[]]]" class="about-panel-vertical vertical-off"><p class="about-panel-vertical-text">Zimbabwe Wildlife Safari</p></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;170dc37b-9148-976e-fa07-22e15e8be09b&quot;],[]]]" class="about-panel-info"><h3 class="about-panel-title">Zimbabwe Wildlife Safari</h3><p class="about-panel-text">Track elephants and other wildlife in Hwange with experienced local guides.</p><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="destination.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Explore this trip</div><div class="primay-button-text _02">Explore this trip</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;6aea26bf-2513-fb92-2639-bd99fdd02483&quot;],[]]]" class="about-panel"><img src="https://irp.cdn-website.com/e6c865a4/dms3rep/multi/opt/IMG_3957-1920w.JPG" loading="lazy" alt="Elephants gathered at a waterhole in Hwange National Park" class="about-panel-image"/><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;62e317d3-c7cd-c98f-b885-a07d535fe4ff&quot;],[]]]" class="about-panel-overlay"></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;7c2ed086-0ea0-4b3c-d8c8-06e7810efd5b&quot;],[]]]" class="about-panel-content"><p data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;606cf494-933c-3d19-3e80-758f4b3cfa96&quot;],[]]]" class="about-panel-number">02</p><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;32f3ae0b-a607-2f2d-9839-df861e7e98b0&quot;],[]]]" class="about-panel-vertical"><p class="about-panel-vertical-text">Victoria Falls Day Tours</p></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;1b9fc61a-6198-f826-e922-173381dd2b92&quot;],[]]]" class="about-panel-info info-off"><h3 class="about-panel-title">Victoria Falls Day Tours</h3><p class="about-panel-text">Explore Victoria Falls, the Zambezi and nearby viewpoints with a knowledgeable local guide.</p><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="destination.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Explore this trip</div><div class="primay-button-text _02">Explore this trip</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;a42273e7-34ce-be47-d981-445020ab319c&quot;],[]]]" class="about-panel"><img src="https://irp.cdn-website.com/e6c865a4/dms3rep/multi/opt/Vic_Falls_Feb_2016_Sarah_Kerr-1421-e1650922121587-1920w.jpg" loading="lazy" sizes="100vw" alt="The spray of Victoria Falls rising above the rainforest" class="about-panel-image"/><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;68b7e5e7-765c-573d-48af-e4ee9aef6044&quot;],[]]]" class="about-panel-overlay"></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;36ce31b1-b3f4-c5b6-9d97-1e7ac7633741&quot;],[]]]" class="about-panel-content"><p data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;e6e8aec7-c4e4-54fd-ac34-240ea615ee3b&quot;],[]]]" class="about-panel-number">03</p><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;70c48aeb-2e7d-b82d-ffc2-b7157d1744a5&quot;],[]]]" class="about-panel-vertical"><p class="about-panel-vertical-text">Cultural Journey</p></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;8cd5e8c5-9788-92d9-bdf8-3da52754436e&quot;],[]]]" class="about-panel-info info-off"><h3 class="about-panel-title">Cultural Journey</h3><p class="about-panel-text">Discover Zimbabwe's history and regional traditions with knowledgeable local guides.</p><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base" href="destination.html" class="primary-button w-inline-block"><div class="button-item-main"><div class="button-text-pill"><div class="primay-button-text _01">Explore this trip</div><div class="primay-button-text _02">Explore this trip</div></div><div class="button-arrow-pill"><div class="arrow-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 21 21" fill="none" class="button-arrow"><path d="M3.5 9.625V11.375H14V13.125H15.75V11.375H17.5V9.625H15.75V7.875H14V9.625H3.5ZM12.25 6.125H14V7.875H12.25V6.125ZM12.25 6.125H10.5V4.375H12.25V6.125ZM12.25 14.875H14V13.125H12.25V14.875ZM12.25 14.875H10.5V16.625H12.25V14.875Z" fill="currentColor"></path></svg></div></div><div class="button-animated-color"></div></div></a></div></div></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;9a216e22-c606-1cc6-2f54-8a0424367eba&quot;],[]]]" class="about-panel"><img src="https://irp.cdn-website.com/e6c865a4/dms3rep/multi/opt/ae9159c2-b88c-4cce-842d-56d53baf764d-2880w.jpg" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 938px) 95vw, 892px" alt="A wide southern African landscape at sunset" class="about-panel-image"/><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;84dba7a3-4409-631e-7d88-65f664739336&quot;],[]]]" class="about-panel-overlay"></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;e91da5ba-8f89-4ea3-8c78-d03659789c9e&quot;],[]]]" class="about-panel-content"><p data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;7248bc0e-0657-7832-2636-a1420ee06530&quot;],[]]]" class="about-panel-number">04</p><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;249d75a6-4352-afc2-d562-c379ef2e37de&quot;],[]]]" class="about-panel-vertical"><p class="about-panel-vertical-text">Adventure Travel</p></div><div data-wf-target="[[[&quot;6ac54b6e7658570aaa3bd29e&quot;,&quot;a5cdc1b7-5763-5b9b-a5fe-02240ebc2fb1&quot;],[]]]" class="about-panel-info info-off"><h3 class="about-panel-title">Adventure Travel</h3><p class="about-panel-text">Enjoy game drives, river adventures and wide-open landscapes with trusted local operators.</p><a data-wf--primary-button--variant="base" data-wf-component-id="b1f5f4f7-681d-fd69-fc1c-e7dcb33d6009" data-wf-variant-state="base